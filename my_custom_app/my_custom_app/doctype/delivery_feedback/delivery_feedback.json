{
 "doctype": "DocType",
 "name": "Delivery Feedback",
 "module": "My Custom App",
 "custom": 0,
 "istable": 0,
 "editable_grid": 1,
 "field_order": [
  "customer",
  "rating",
  "note",
  "reviewed",
  "workflow_state"
 ],
 "fields": [
  {
   "fieldname": "customer",
   "fieldtype": "Link",
   "label": "Customer",
   "options": "Customer",
   "reqd": 1
  },
  {
   "fieldname": "rating",
   "fieldtype": "Select",
   "label": "Rating",
   "options": "1\n2\n3\n4\n5",
   "reqd": 1
  },
  {
   "fieldname": "note",
   "fieldtype": "Small Text",
   "label": "Note"
  },
  {
   "fieldname": "reviewed",
   "fieldtype": "Check",
   "label": "Reviewed",
   "default": "0"
  },
  {
   "fieldname": "workflow_state",
   "fieldtype": "Link",
   "label": "Workflow State",
   "options": "Workflow State",
   "read_only": 1
}
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  }
 ]
}